# ---------------------------------------------------------------------------
# Unreal Engine 5.8 — .gitattributes
# Save this file as ".gitattributes" in your repo root.
#
# Commit this file BEFORE you commit any content. Patterns added after a file
# is already tracked do not retroactively move it into LFS.
#
# Setup, once, from the repo root:
#     git lfs install
#     git add .gitattributes
#     git commit -m "Add LFS tracking rules"
#
# "lockable" means you can call `git lfs lock <path>` to mark a binary asset as
# yours while you work on it. Worth doing the moment a second person touches the
# project — binary assets cannot be merged, so a lock is the only real conflict
# prevention there is.
# ---------------------------------------------------------------------------

# --- Unreal binary assets -------------------------------------------------
*.uasset  filter=lfs diff=lfs merge=lfs -text lockable
*.umap    filter=lfs diff=lfs merge=lfs -text lockable

# --- Source art and meshes ------------------------------------------------
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.obj     filter=lfs diff=lfs merge=lfs -text
*.blend   filter=lfs diff=lfs merge=lfs -text
*.abc     filter=lfs diff=lfs merge=lfs -text

# --- Textures -------------------------------------------------------------
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text
*.tif     filter=lfs diff=lfs merge=lfs -text
*.tiff    filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text

# --- Audio ----------------------------------------------------------------
*.wav     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.flac    filter=lfs diff=lfs merge=lfs -text
*.aif     filter=lfs diff=lfs merge=lfs -text
*.aiff    filter=lfs diff=lfs merge=lfs -text

# --- Video ----------------------------------------------------------------
*.mp4     filter=lfs diff=lfs merge=lfs -text
*.mov     filter=lfs diff=lfs merge=lfs -text
*.bk2     filter=lfs diff=lfs merge=lfs -text

# --- Fonts and misc binaries ---------------------------------------------
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text
*.icu     filter=lfs diff=lfs merge=lfs -text
*.pdf     filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text

# --- Text: normalise line endings so Windows/other diffs stay clean -------
*.cpp       text diff=cpp
*.h         text diff=cpp
*.cs        text diff=csharp
*.ini       text
*.uproject  text eol=lf
*.uplugin   text eol=lf
*.md        text
*.json      text
*.py        text diff=python
*.bat       text eol=crlf
*.sh        text eol=lf
