{
  "name": "clyde-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "BSD-2-Clause",
  "scripts": {
    "start": "npm run build && tsx server/play.ts",
    "play": "tsx server/play.ts",
    "package": "tsx tools/package.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "tsx tests/e2e/folder-input.e2e.ts",
    "import-scenes": "tsx tools/import-scenes.ts",
    "scan": "tsx tools/scan.ts",
    "dump": "tsx tools/dump.ts",
    "levels": "tsx tools/levels.ts",
    "coverage": "tsx tools/coverage.ts",
    "capture": "tsx tools/capture/play.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "^1.47.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
